{
  "name": "proba-init",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "CLAUDE_PROVIDER=cli electron .",
    "desktop": "npm run build && npm run electron",
    "desktop:dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^43.4.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "app.proba.desktop",
    "productName": "Proba",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json",
      "next.config.mjs",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "Proba.app/Contents/Resources/Proba.icns",
      "target": [
        "dir"
      ]
    },
    "directories": {
      "output": "dist-desktop"
    }
  }
}
