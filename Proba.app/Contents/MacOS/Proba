#!/bin/bash
# ─────────────────────────────────────────────────────────────
#  Proba.app — natywna aplikacja na macOS (Electron)
#
#  Otwiera własne okno programu (bez przeglądarki). Serwer Proby
#  startuje wewnątrz apki w trybie CLI, więc analizy idą przez
#  subskrypcję Claude, a nie przez płatne API.
#
#  Apkę można trzymać gdziekolwiek (np. w /Applications) —
#  ścieżkę do projektu launcher zapamiętuje przy pierwszym starcie.
# ─────────────────────────────────────────────────────────────

# Powłoka logowania → pełny PATH (Homebrew, nvm, ffmpeg, claude).
if [ -z "$PROBA_RELAUNCHED" ]; then
  export PROBA_RELAUNCHED=1
  exec /bin/zsh -l "$0" "$@"
fi

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$HOME/Library/Logs"
LOG="$LOG_DIR/Proba.log"
CONFIG_DIR="$HOME/Library/Application Support/Proba"
CONFIG="$CONFIG_DIR/repo-path"
mkdir -p "$LOG_DIR" "$CONFIG_DIR"

notify() {
  /usr/bin/osascript -e "display notification \"$1\" with title \"Proba\"" >/dev/null 2>&1 || true
}

fail() {
  /usr/bin/osascript -e "display dialog \"$1\" with title \"Proba\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1 || true
  exit 1
}

is_proba_repo() {
  [ -f "$1/package.json" ] && [ -f "$1/src/lib/council.ts" ]
}

# ── Ustal katalog projektu ──
REPO_ROOT=""
CANDIDATE="$(cd "$SELF_DIR/../../.." 2>/dev/null && pwd)"
if [ -n "$CANDIDATE" ] && is_proba_repo "$CANDIDATE"; then
  REPO_ROOT="$CANDIDATE"
fi

if [ -z "$REPO_ROOT" ] && [ -f "$CONFIG" ]; then
  SAVED="$(cat "$CONFIG")"
  if is_proba_repo "$SAVED"; then REPO_ROOT="$SAVED"; fi
fi

if [ -z "$REPO_ROOT" ]; then
  for DIR in "$HOME/proba" "$HOME/Developer/proba" "$HOME/Documents/proba" \
             "$HOME/Desktop/proba" "$HOME/Projects/proba" "$HOME/code/proba"; do
    if is_proba_repo "$DIR"; then REPO_ROOT="$DIR"; break; fi
  done
fi

if [ -z "$REPO_ROOT" ]; then
  CHOSEN="$(/usr/bin/osascript <<'APPLESCRIPT' 2>/dev/null
try
  display dialog "Wskaż folder z projektem Proba (sklonowane repozytorium)." with title "Proba" buttons {"Wybierz folder"} default button 1
  set f to choose folder with prompt "Gdzie jest folder proba?"
  POSIX path of f
end try
APPLESCRIPT
)"
  CHOSEN="${CHOSEN%/}"
  if [ -n "$CHOSEN" ] && is_proba_repo "$CHOSEN"; then
    REPO_ROOT="$CHOSEN"
    printf '%s' "$REPO_ROOT" > "$CONFIG"
  fi
fi

[ -n "$REPO_ROOT" ] || fail "Nie znalazłem projektu Proba. Sklonuj go:  git clone https://github.com/matirychlik-arch/proba.git  — a potem uruchom Probę ponownie i wskaż ten folder."
printf '%s' "$REPO_ROOT" > "$CONFIG"

# ── Wymagania twarde ──
command -v node >/dev/null 2>&1 || fail "Brak Node.js. Zainstaluj wersję LTS ze strony nodejs.org i uruchom Probę ponownie."
NODE_MAJOR=$(node -v | sed 's/v\([0-9]*\).*/\1/')
[ "$NODE_MAJOR" -ge 18 ] 2>/dev/null || fail "Node.js $(node -v) jest za stary — potrzeba wersji 18 lub nowszej (nodejs.org)."
command -v claude >/dev/null 2>&1 || fail "Brak Claude Code. W Terminalu wykonaj: npm install -g @anthropic-ai/claude-code — a potem zaloguj się komendą: claude"

cd "$REPO_ROOT" || fail "Nie mogę wejść do katalogu projektu: $REPO_ROOT"

# ── Instalacja / build przy pierwszym starcie lub po aktualizacji ──
if [ ! -d node_modules ] || [ ! -d node_modules/electron ]; then
  notify "Pierwsze uruchomienie — instaluję zależności (3-5 min)..."
  npm install --no-fund --no-audit >>"$LOG" 2>&1 || fail "npm install nie powiódł się. Szczegóły: ~/Library/Logs/Proba.log"
fi
if [ ! -d .next ] || [ -n "$(find src package.json -newer .next -print -quit 2>/dev/null)" ]; then
  notify "Buduję aplikację..."
  npm run build >>"$LOG" 2>&1 || fail "Build nie powiódł się. Szczegóły: ~/Library/Logs/Proba.log"
fi

# ── Wymaganie miękkie: ffmpeg włącza analizę wideo ──
if ! command -v ffmpeg >/dev/null 2>&1; then
  notify "Analiza wideo wyłączona — zainstaluj: brew install ffmpeg"
fi

# ── Start natywnego okna ──
export CLAUDE_PROVIDER=cli
exec npx electron . >>"$LOG" 2>&1
