# Opcjonalny klucz API do developmentu.
# W produkcji użytkownik podaje własny klucz w /settings (localStorage).
ANTHROPIC_API_KEY=sk-ant-...

# Provider lokalny: "cli" = używaj Claude Code (subskrypcja) zamiast API.
# Działa tylko lokalnie — nigdy na Vercelu. Ustawiane automatycznie przez Proba.command.
# CLAUDE_PROVIDER=cli
